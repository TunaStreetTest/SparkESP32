# Waveshare ESP32-S3-Touch-AMOLED-1.8 V2: ESP32-S3R8, 16 MB flash and 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/waveshare-esp32s3-amoled-1.8-v2/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# console on the native USB-Serial/JTAG port (the agent's USB transport)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# the portrait layout's title, and both layouts' tile values (firmware/main/ui.c)
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_36=y
